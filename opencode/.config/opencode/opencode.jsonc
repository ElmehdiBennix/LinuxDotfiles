{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/qwen",
  "providers": {
    "vllm": {
      "name": "Local vLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen": {
          "modelID": "/home/rambeau/ai-models/Qwen3.8-27B-AWQ-18GB",
          "name": "Qwen 3.8 27B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    }
  }
}
